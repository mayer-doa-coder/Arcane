## Parser Test - Demonstrates various language features

spell add(a: essence, b: essence) -> essence {
    return a + b;
}

spell factorial(n: essence) -> essence {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

ritual main() {
    essence x = 10;
    essence y = 5;
    essence sum = add(x, y);
    
    while (x > 0) {
        manifest(x);
        x--;
    }
    
    if (sum > 10) {
        manifest(sum);
    } else {
        manifest(y);
    }
}
