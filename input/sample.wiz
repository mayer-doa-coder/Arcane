## Wizard64 sample program using final keyword set

ENTER_HOGWARTS HOUSE
    Gryffindor HOUSE
        DECLARE score AS INT := 10;
        DECLARE ratio AS FLOAT := 3.14;
        DECLARE charm AS DOUBLE := 2.71828;
        DECLARE mana AS LONG := 9999;
        DECLARE initial AS CHAR := 'W';
        DECLARE ready AS BOOL := true;
    ENDHOUSE

    Slytherin SPELL empower WITH(score, ratio) HOUSE
        CAST("Empower spell started");
        PROPHECY("score=", score);

        IF_CHARM(score > 0) THEN
            DECLARE raised AS INT := score + 5;
            RETURN raised;
        OTHERWISE
            RETURN 0;
        END_CHARM
    ENDSPELL

    Ravenclaw TIME_TURNER(score > 0) BEGIN_LOOP
        score = score - 1;

        IF_CHARM score == 5 THEN
            CAST("Halfway reached");
            KEEP_CASTING;
END_CHARM
        IF_CHARM score == 2 THEN
            BREAK_SPELL;
END_CHARM
    END_TIME_TURNER

    POTION HOUSE
        DECLARE p AS FLOAT := POWER(2);
        DECLARE r AS FLOAT := ROOT(16);
        DECLARE f AS FLOAT := FLOOR(2.8);
        DECLARE c AS FLOAT := CEIL(2.1);
        DECLARE a AS FLOAT := ABS(-7);
        DECLARE l AS FLOAT := LOG(10);
        DECLARE s AS FLOAT := SIN(1);
        DECLARE co AS FLOAT := COS(1);
        DECLARE t AS FLOAT := TAN(1);

        DECLARE logic AS BOOL := true AND NOT false OR true XOR false;
        INPUT(score);
        SUMMON empower WITH(score, ratio);
    ENDPOTION

    SORTING_HAT HOUSE
        CHECK_TYPES;
        CHECK_DECLARATIONS;
    ENDHAT
EXIT_HOGWARTS ENDHOUSE

