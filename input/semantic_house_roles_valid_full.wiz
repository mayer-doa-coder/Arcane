ENTER_HOGWARTS
HOUSE Gryffindor
DECLARE i AS INT := 0;
ENDHOUSE

HOUSE Slytherin
SPELL inc AS INT WITH (x AS INT) HOUSE
RETURN x + 1;
ENDSPELL
ENDHOUSE

HOUSE Hufflepuff
IF_CHARM i < 2 THEN
CAST "if block ok";
END_CHARM
ENDHOUSE

HOUSE Ravenclaw
TIME_TURNER i < 2 BEGIN_LOOP
i = inc(i);
CAST i;
END_TIME_TURNER
ENDHOUSE

EXIT_HOGWARTS
