ENTER_HOGWARTS

HOUSE Gryffindor
DECLARE i AS INT := 1;
ENDHOUSE

HOUSE Slytherin
SPELL showPrime WITH (x) HOUSE
CAST x;
ENDSPELL
ENDHOUSE

HOUSE Ravenclaw
TIME_TURNER i < 11 BEGIN_LOOP
SUMMON showPrime WITH (i);
i = i + 1;
END_TIME_TURNER
ENDHOUSE

HOUSE Hufflepuff
IF_CHARM i == 11 THEN
CAST "Prime listing finished";
END_CHARM
ENDHOUSE

EXIT_HOGWARTS
