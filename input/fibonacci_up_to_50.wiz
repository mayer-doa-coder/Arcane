ENTER_HOGWARTS

HOUSE Gryffindor
DECLARE a AS INT := 0;
DECLARE b AS INT := 1;
DECLARE next AS INT := 0;
DECLARE limit AS INT := 50;
ENDHOUSE

Slytherin
SPELL houseReady HOUSE
ENDSPELL

HOUSE Hufflepuff
IF_CHARM a < limit THEN
CAST a;
END_CHARM
ENDHOUSE

HOUSE Ravenclaw
TIME_TURNER b < limit BEGIN_LOOP
CAST b;
next = a + b;
a = b;
b = next;
END_TIME_TURNER
ENDHOUSE

EXIT_HOGWARTS
